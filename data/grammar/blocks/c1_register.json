      "id": "c1_register_main",
      "title": "Register: formal vs informal · C1",
      "items": [
        {
          "en": "We regret to inform you of the delay.",
          "cz": "S lítostí vás informujeme o zpoždění.",
          "gap": "We regret ____ inform you of the delay.",
          "gap_answer": "to",
          "accepts": [
            "We regret to inform you of the delay."
          ],
          "explanation": "Formal: regret to inform.",
          "explanation_cz": "Formální: regret to inform."
        },
        {
          "en": "Kids shouldn't mess with that switch.",
          "cz": "Děti by s tím vypínačem neměly šahat.",
          "gap": "Kids shouldn't ____ with that switch.",
          "gap_answer": "mess",
          "accepts": [
            "Kids shouldn't mess with that switch."
          ],
          "explanation": "Informal lexis + phrasal mess with.",
          "explanation_cz": "Neformální lexis + phrasal."
        },
        {
          "en": "Assistance will be provided upon request.",
          "cz": "Pomoc bude poskytnuta na požádání.",
          "gap": "Assistance will be ____ upon request.",
          "gap_answer": "provided",
          "accepts": [
            "Assistance will be provided upon request."
          ],
          "explanation": "Passive + abstract subject = formal.",
          "explanation_cz": "Pasiv + abstraktní podmět = formální."
        },
        {
          "en": "I reckon it'll rain later.",
          "cz": "Myslím, že později zaprší.",
          "gap": "I ____ it'll rain later.",
          "gap_answer": "reckon",
          "accepts": [
            "I reckon it'll rain later."
          ],
          "explanation": "reckon = informal think.",
          "explanation_cz": "reckon = neformální think."
        },
        {
          "en": "Should you require further information, contact us.",
          "cz": "Pokud budete potřebovat další informace, kontaktujte nás.",
          "gap": "____ you require further information, contact us.",
          "gap_answer": "Should",
          "accepts": [
            "Should you require further information, contact us."
          ],
          "explanation": "Should-inversion = formal conditional.",
          "explanation_cz": "Should-inverze = formální kondicionál."
        },
        {
          "en": "Got any ideas?",
          "cz": "Máš nějaký nápad?",
          "gap": "____ any ideas?",
          "gap_answer": "Got",
          "accepts": [
            "Got any ideas?"
          ],
          "explanation": "Elliptical Got…? = informal.",
          "explanation_cz": "Eliptické Got…? = neformální."
        },
        {
          "en": "The committee shall convene at noon.",
          "cz": "Výbor se sejde v poledne.",
          "gap": "The committee ____ convene at noon.",
          "gap_answer": "shall",
          "accepts": [
            "The committee shall convene at noon."
          ],
          "explanation": "shall = formal obligation/schedule.",
          "explanation_cz": "shall = formální povinnost/rozvrh."
        },
        {
          "en": "Hang on a sec.",
          "cz": "Počkej chvilku.",
          "gap": "Hang ____ a sec.",
          "gap_answer": "on",
          "accepts": [
            "Hang on a sec."
          ],
          "explanation": "Phrasal hang on + sec = informal.",
          "explanation_cz": "Phrasal hang on + sec = neformální."
        },
        {
          "en": "It is recommended that applicants submit forms early.",
          "cz": "Doporučuje se, aby žadatelé odevzdali formuláře brzy.",
          "gap": "It is recommended that applicants ____ forms early.",
          "gap_answer": "submit",
          "accepts": [
            "It is recommended that applicants submit forms early."
          ],
          "explanation": "Impersonal it + subjunctive = formal.",
          "explanation_cz": "Neosobní it + subjunktiv = formální."
        },
        {
          "en": "She's gonna quit next month.",
          "cz": "Příští měsíc to prý hodí.",
          "gap": "She's ____ quit next month.",
          "gap_answer": "gonna",
          "accepts": [
            "She's gonna quit next month."
          ],
          "explanation": "gonna = informal going to.",
          "explanation_cz": "gonna = neformální going to."
        }
      ]
    }
  ],
