  "intro": {
    "cards": [
      {
        "title": "What it is",
        "body": "English likes a clear order: **Subject → Verb → Object** (SVO).",
        "table": {
          "headers": [
            "1 Subject",
            "2 Verb",
            "3 Object"
          ],
          "rows": [
            [
              "I",
              "have",
              "a car"
            ],
            [
              "She",
              "needs",
              "a phone"
            ],
            [
              "We",
              "have",
              "two dogs"
            ]
          ]
        },
        "points": [
          "S = who · V = action · O = what / who",
          "Keep this order in simple positive sentences"
        ]
      },
      {
        "title": "Place and time",
        "body": "Place and time usually go **at the end**. If both appear, **place before time**.",
        "table": {
          "headers": [
            "Sentence core",
            "place",
            "time"
          ],
          "rows": [
            [
              "I have English",
              "in Brno",
              "on Monday"
            ],
            [
              "She has students",
              "in Prague",
              "on Friday"
            ],
            [
              "We have English",
              "in Vienna",
              "at three o'clock"
            ]
          ]
        }
      },
      {
        "title": "Common mistakes",
        "table": {
          "headers": [
            "Avoid",
            "Say"
          ],
          "rows": [
            [
              "I a car have.",
              "I **have a car**."
            ],
            [
              "She a nice phone needs.",
              "She **needs a nice phone**."
            ],
            [
              "I have English on Monday in Brno.",
              "I have English **in Brno on Monday**."
            ],
            [
              "Always she has English on Monday.",
              "She **always** has English on Monday."
            ]
          ]
        },
        "points": [
          "CZ tip: don't put the object before the verb",
          "Place before time when both are at the end"
        ]
      },
      {
        "title": "Quick check",
        "points": [
          "have / I / a car → **I have a car**",
          "in Prague / has / she / friends → **She has friends in Prague**",
          "on Saturday / a car / he needs → **He needs a car on Saturday**"
        ]
      }
    ]
  }
