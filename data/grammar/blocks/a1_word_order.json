  "intro": {
    "cards": [
      {
        "title": "What it is",
        "body": "English likes a clear order: **Subject → Verb → Object** (SVO).",
        "table": {
          "headers": [
            "1 Subject",
            "2 Verb",
            "3 Object"
          ],
          "rows": [
            [
              "I",
              "like",
              "coffee"
            ],
            [
              "She",
              "reads",
              "books"
            ],
            [
              "We",
              "eat",
              "lunch"
            ]
          ]
        },
        "points": [
          "S = who · V = action · O = what / who",
          "Keep this order in simple positive sentences"
        ]
      },
      {
        "title": "Place and time",
        "body": "Place and time usually go **at the end**. If both appear, **place before time**.",
        "table": {
          "headers": [
            "Sentence core",
            "place",
            "time"
          ],
          "rows": [
            [
              "I work",
              "in Brno",
              "on Monday"
            ],
            [
              "We eat lunch",
              "at home",
              "on Sunday"
            ],
            [
              "She studies",
              "in the library",
              "every evening"
            ]
          ]
        }
      },
      {
        "title": "Common mistakes",
        "table": {
          "headers": [
            "Avoid",
            "Say"
          ],
          "rows": [
            [
              "I coffee like.",
              "I **like coffee**."
            ],
            [
              "She English speaks well.",
              "She **speaks English** well."
            ],
            [
              "I work on Monday in Brno.",
              "I work **in Brno on Monday**."
            ],
            [
              "Always I drink tea.",
              "I **always** drink tea. (or: I drink tea every day)"
            ]
          ]
        },
        "points": [
          "CZ tip: don't put the object before the verb",
          "Place before time when both are at the end"
        ]
      },
      {
        "title": "Quick check",
        "points": [
          "like / I / coffee → **I like coffee**",
          "in Brno / works / she → **She works in Brno**",
          "every day / bread / he buys → **He buys bread every day**"
        ]
      }
    ]
  }
