{
  "id": "a2_adverbs_order",
  "title": "Adverb position",
  "level": "A2",
  "tree_node": "a2_adverbs_order",
  "codex_unit": "G_SS-A1B1-01",
  "practice": "frames",
  "note": "Position, not which adverb. Frequency (always/usually) is A1 — those words are carriers. Mid: always drink / after is (before the adjective) / after can. too/either end vs also mid. Manner at the end. like + object + very much. · 2026-08-29 smoke: I8; B8 slot chips; B11 (always/drink) Type cues; B16 sort columns are the pattern not before verb; C37 sort chips bold the adverb; C38 also/too are not conjunctions.",
  "default_direction": "cz_to_en",
  "check": {
    "sequence": [
      "sort_bins",
      "quiz"
    ]
  },
  "bins": [
    "before the verb",
    "after be / after can",
    "at the end"
  ],
  "sort_rule": "First look for be or can. If the sentence has one, the adverb goes after it; if not, the adverb goes before the verb.",
  "bin_captions": {
    "before the verb": "still live · often watch",
    "after be / after can": "is often tired",
    "at the end": "hard · too · either"
  },
