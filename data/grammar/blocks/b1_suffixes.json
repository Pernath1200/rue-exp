  "intro": {
    "cards": [
      {
        "title": "What a suffix does",
        "body": "A suffix is an ending that changes the WORD CLASS: teach (verb) → teacher (person), happy (adjective) → happiness (noun), quick (adjective) → quickly (adverb).",
        "points": [
          "The sentence tells you which class you need.",
          "Type the whole new word, not just the ending."
        ]
      },
      {
        "title": "People: -er / -or / -ist",
        "table": {
          "headers": [
            "Verb / Noun",
            "Person"
          ],
          "rows": [
            [
              "teach",
              "teacher"
            ],
            [
              "drive",
              "driver"
            ],
            [
              "act",
              "actor"
            ],
            [
              "art",
              "artist"
            ]
          ]
        },
        "points": [
          "-er is the everyday one; -or appears on Latin-style verbs (actor, visitor, inventor).",
          "-ist often means a professional or specialist: artist, scientist, tourist."
        ]
      },
      {
        "title": "Nouns: -tion / -ment / -ness",
        "table": {
          "headers": [
            "Root",
            "Noun"
          ],
          "rows": [
            [
              "inform",
              "information"
            ],
            [
              "decide",
              "decision"
            ],
            [
              "pay",
              "payment"
            ],
            [
              "kind",
              "kindness"
            ]
          ]
        },
        "points": [
          "-tion / -sion for actions and results — watch the stem: decide → decision, permit → permission.",
          "-ness turns adjectives into feelings and qualities: sad → sadness, ill → illness."
        ]
      },
      {
        "title": "Adjectives and adverbs",
        "table": {
          "headers": [
            "Root",
            "New word"
          ],
          "rows": [
            [
              "care",
              "careful / careless"
            ],
            [
              "sun",
              "sunny"
            ],
            [
              "danger",
              "dangerous"
            ],
            [
              "quick",
              "quickly"
            ]
          ]
        },
        "points": [
          "-ful = with it, -less = without it: careful / careless.",
          "-y makes weather and everyday adjectives: sunny, rainy, dirty.",
          "-ly makes adverbs: quick → quickly, happy → happily (y → i)."
        ]
      }
    ]
  },
