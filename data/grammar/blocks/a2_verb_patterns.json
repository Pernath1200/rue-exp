  "intro": {
    "cards": [
      {
        "title": "Verb patterns 1 (to / -ing)",
        "title_cz": "Vzorce sloves 1 (to / -ing)",
        "text_first": true,
        "table": {
          "caption": "main patterns",
          "headers": [
            "Pattern",
            "Example"
          ],
          "rows": [
            [
              "verb + **to** + verb",
              "want **to go**"
            ],
            [
              "verb + **-ing**",
              "enjoy **swimming**"
            ]
          ]
        },
        "points": [
          "After some verbs, another verb follows — in a pattern.",
          "Not after every verb. The first verb picks the pattern."
        ]
      },
      {
        "title": "to or -ing",
        "title_cz": "to, nebo -ing",
        "diagram": "contrast",
        "labels": [
          "to + verb",
          "verb + -ing",
          "want to go",
          "enjoy going"
        ],
        "diagram_fallback": "to + verb — want to go · verb + -ing — enjoy going",
        "table": {
          "caption": "not this",
          "headers": [
            "Not",
            "Say"
          ],
          "rows": [
            [
              "~~I want go~~",
              "I **want to** go"
            ],
            [
              "~~I enjoy to swim~~",
              "I **enjoy swimming**"
            ]
          ]
        },
        "points": [
          "**to** = the action is still ahead.",
          "**-ing** = the action is the activity."
        ]
      },
      {
        "title": "to is more common",
        "title_cz": "to je častější",
        "text_first": true,
        "table": {
          "caption": "how often",
          "headers": [
            "Pattern",
            "How often"
          ],
          "rows": [
            [
              "**to** + verb",
              "about **4**"
            ],
            [
              "verb + **-ing**",
              "about **1**"
            ]
          ]
        },
        "points": [
          "English uses **to** much more than **-ing**.",
          "About four **to** for every one **-ing**.",
          "The first verb still picks. This is only how often."
        ]
      },
      {
        "title": "to + verb",
        "title_cz": "sloveso + to",
        "text_first": true,
        "table": {
          "caption": "to",
          "headers": [
            "Verb",
            "Example"
          ],
          "rows": [
            [
              "**want**",
              "I want **to go** home"
            ],
            [
              "**need**",
              "We need **to leave**"
            ],
            [
              "**decide**",
              "She decided **to stay**"
            ],
            [
              "**hope**",
              "They hope **to win**"
            ],
            [
              "**plan**",
              "I plan **to stay**"
            ]
          ]
        },
        "points": [
          "**promise**, **offer**, **agree** also take **to**.",
