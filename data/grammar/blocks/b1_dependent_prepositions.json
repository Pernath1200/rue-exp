  "intro": {
    "cards": [
      {
        "title": "What they are",
        "title_cz": "Co to jsou",
        "text_first": true,
        "diagram": "hub_spokes",
        "labels": [
          "dependent preposition depends on",
          "adjective",
          "interested in",
          "verb",
          "wait for",
          "noun",
          "reason for"
        ],
        "points": [
          "A preposition is a small word before a noun: **in**, **at**, **on**, **for**",
          "A *dependent* one is chosen by the word before it — adjective, verb, or noun",
          "It comes after that word. You cannot guess which one"
        ],
