  "intro": {
    "cards": [
      {
        "title": "What it is",
        "body": "The verb must **fit the subject**. In the present simple, **he / she / it** take **-s**.",
        "points": [
          "I / you / we / they → base verb (**work**)",
          "he / she / it → verb + **-s** (**works**)",
          "Names and singular nouns = he/she/it (**Anna works** · **the shop opens**)"
        ]
      },
      {
        "title": "Form",
        "table": {
          "headers": [
            "Subject",
            "Verb"
          ],
          "rows": [
            [
              "I / you / we / they",
              "work · like · go · have"
            ],
            [
              "he / she / it",
              "works · likes · goes · has"
            ]
          ]
        },
        "points": [
          "Spelling: watch → **watches** · study → **studies** · go → **goes**",
          "have → **has** (not haves)"
        ]
      },
      {
        "title": "Common mistakes",
        "table": {
          "headers": [
            "Avoid",
            "Say"
          ],
          "rows": [
            [
              "He **work** here.",
              "He **works** here."
            ],
            [
              "She **like** coffee.",
              "She **likes** coffee."
            ],
            [
              "They **works** here.",
              "They **work** here."
            ],
            [
              "We **goes** home.",
              "We **go** home."
            ]
          ]
        },
        "points": [
          "Missing **-s** after he/she/it (very common from Czech)",
          "Extra **-s** after I/you/we/they or plural nouns"
        ]
      },
      {
        "title": "Quick check",
        "points": [
          "She ____ in a shop. → **works**",
          "They ____ in a shop. → **work**",
          "My brother ____ football. → **plays**",
          "My parents ____ tennis. → **play**"
        ]
      }
    ]
  }
