  "blocks": [
    {
      "id": "questions_negatives_a1",
      "title": "Questions & negatives · A1",
      "items": [
        {
          "en": "Do you speak English?",
          "cz": "Mluvíš anglicky?",
          "gap": "____ you speak English?",
          "gap_answer": "Do",
          "accepts": [
            "Do you speak English?"
          ],
          "quiz_options": ["Do", "Does", "Are", "Is"],
          "explanation": "**Do** + you + speak. Not *Are you speak*.",
          "explanation_cz": "**Do** + you + speak. Ne *Are you speak*."
        },
        {
          "en": "Do you live here?",
          "cz": "Bydlíš tady?",
          "gap": "____ you live here?",
          "gap_answer": "Do",
          "accepts": [
            "Do you live here?"
          ],
          "quiz_options": ["Do", "Does", "Are", "Is"],
          "explanation": "**Do** with you. Not *Are you live*.",
          "explanation_cz": "**Do** s you. Ne *Are you live*."
        },
        {
          "en": "Does she work here?",
          "cz": "Pracuje ona tady?",
          "gap": "____ she work here?",
          "gap_answer": "Does",
          "accepts": [
            "Does she work here?"
          ],
          "quiz_options": ["Does", "Do", "Is", "Are"],
          "explanation": "**Does** with she. Verb = **work**, not *works*.",
          "explanation_cz": "**Does** s she. Sloveso **work**, ne *works*."
        },
        {
          "en": "Does he speak Czech?",
          "cz": "Mluví on česky?",
          "gap": "____ he speak Czech?",
          "gap_answer": "Does",
          "accepts": [
            "Does he speak Czech?"
          ],
          "quiz_options": ["Does", "Do", "Is", "Are"],
          "explanation": "**Does** with he. Verb stays **speak**.",
          "explanation_cz": "**Does** s he. Sloveso **speak**."
        },
        {
          "en": "Do they have a car?",
          "cz": "Mají auto?",
          "gap": "____ they have a car?",
          "gap_answer": "Do",
          "accepts": [
            "Do they have a car?",
            "Have they got a car?"
          ],
          "quiz_options": ["Do", "Does", "Are", "Is"],
          "explanation": "**Do** with they + have.",
          "explanation_cz": "**Do** s they + have."
        },
        {
          "en": "Does he play football?",
          "cz": "Hraje on fotbal?",
          "gap": "____ he play football?",
          "gap_answer": "Does",
          "accepts": [
            "Does he play football?"
          ],
          "quiz_options": ["Does", "Do", "Is", "Are"],
          "explanation": "**Does** with he. Verb = **play**, not *plays*.",
          "explanation_cz": "**Does** s he. Sloveso **play**, ne *plays*."
        },
        {
          "en": "Are you tired?",
          "cz": "Jsi unavený?",
          "gap": "____ you tired?",
          "gap_answer": "Are",
          "accepts": [
            "Are you tired?"
          ],
          "quiz_options": ["Are", "Is", "Do", "Does"],
          "explanation": "**Are** you…? Be — no *do*.",
          "explanation_cz": "**Are** you…? Be — ne *do*."
        },
        {
          "en": "Is he a student?",
          "cz": "Je on student?",
          "gap": "____ he a student?",
          "gap_answer": "Is",
          "accepts": [
            "Is he a student?"
          ],
          "quiz_options": ["Is", "Are", "Do", "Does"],
          "explanation": "**Is** he…? Be — no *does*.",
          "explanation_cz": "**Is** he…? Be — ne *does*."
        },
        {
          "en": "Is she at home?",
          "cz": "Je ona doma?",
          "gap": "____ she at home?",
          "gap_answer": "Is",
          "accepts": [
            "Is she at home?"
          ],
          "quiz_options": ["Is", "Are", "Do", "Does"],
          "explanation": "**Is** she…? Be, not *Does she at home*.",
          "explanation_cz": "**Is** she…? Be, ne *Does she at home*."
        },
        {
          "en": "Are they friends?",
          "cz": "Jsou kamarádi?",
          "gap": "____ they friends?",
          "gap_answer": "Are",
          "accepts": [
            "Are they friends?"
          ],
          "quiz_options": ["Are", "Is", "Do", "Does"],
          "explanation": "**Are** they…? Be — no *do*.",
          "explanation_cz": "**Are** they…? Be — ne *do*."
        },
        {
          "en": "I don't like football.",
          "cz": "Nemám rád fotbal.",
          "gap": "I ____ like football.",
          "gap_answer": "don't",
          "gap_accepts": [
            "do not"
          ],
          "accepts": [
            "I do not like football.",
            "I don't like football."
          ],
          "quiz_options": ["don't", "doesn't", "isn't", "aren't"],
          "explanation": "**don't** + like. Not *am not like*.",
          "explanation_cz": "**don't** + like. Ne *am not like*."
        },
        {
          "en": "She doesn't live here.",
          "cz": "Ona nebydlí tady.",
          "gap": "She ____ live here.",
          "gap_answer": "doesn't",
          "gap_accepts": [
            "does not"
          ],
          "accepts": [
            "She does not live here.",
            "She doesn't live here."
          ],
          "quiz_options": ["doesn't", "don't", "isn't", "aren't"],
          "explanation": "**doesn't** + live. Not *doesn't lives*.",
          "explanation_cz": "**doesn't** + live. Ne *doesn't lives*."
        },
        {
          "en": "He doesn't work here.",
          "cz": "On tady nepracuje.",
          "gap": "He ____ work here.",
          "gap_answer": "doesn't",
          "gap_accepts": [
            "does not"
          ],
          "accepts": [
            "He does not work here.",
            "He doesn't work here."
          ],
          "quiz_options": ["doesn't", "don't", "isn't", "aren't"],
          "explanation": "**doesn't** with he. Verb = **work**.",
          "explanation_cz": "**doesn't** s he. Sloveso **work**."
        },
        {
          "en": "We don't work here.",
          "cz": "Tady nepracujeme.",
          "gap": "We ____ work here.",
          "gap_answer": "don't",
          "gap_accepts": [
            "do not"
          ],
          "accepts": [
            "We do not work here.",
            "We don't work here."
          ],
          "quiz_options": ["don't", "doesn't", "isn't", "aren't"],
          "explanation": "**don't** with we. Not *aren't work*.",
          "explanation_cz": "**don't** s we. Ne *aren't work*."
        },
        {
          "en": "They don't like films.",
          "cz": "Oni nemají rádi filmy.",
          "gap": "They ____ like films.",
          "gap_answer": "don't",
          "gap_accepts": [
            "do not"
          ],
          "accepts": [
            "They do not like films.",
            "They don't like films.",
            "They do not like movies.",
            "They don't like movies."
          ],
          "quiz_options": ["don't", "doesn't", "isn't", "aren't"],
          "explanation": "**don't** with they. Not *aren't like*.",
          "explanation_cz": "**don't** s they. Ne *aren't like*."
        },
        {
          "en": "I am not tired.",
          "cz": "Nejsem unavený.",
          "gap": "I ____ not tired.",
          "gap_answer": "am",
          "accepts": [
            "I'm not tired.",
            "I am not tired."
          ],
          "quiz_options": ["am", "is", "are", "don't"],
          "explanation": "I **am** not. Not *I don't tired*.",
          "explanation_cz": "I **am** not. Ne *I don't tired*."
        },
        {
          "en": "She isn't a teacher.",
          "cz": "Ona není učitelka.",
          "gap": "She ____ a teacher.",
          "gap_answer": "isn't",
          "gap_accepts": [
            "is not"
          ],
          "accepts": [
            "She is not a teacher.",
            "She isn't a teacher.",
            "She's not a teacher."
          ],
          "quiz_options": ["isn't", "aren't", "doesn't", "don't"],
          "explanation": "**isn't** = is not. Be, not *doesn't*.",
          "explanation_cz": "**isn't** = is not. Be, ne *doesn't*."
        },
        {
          "en": "They aren't at home.",
          "cz": "Nejsou doma.",
          "gap": "They ____ at home.",
          "gap_answer": "aren't",
          "gap_accepts": [
            "are not"
          ],
          "accepts": [
            "They are not at home.",
            "They're not at home.",
            "They aren't at home."
          ],
          "quiz_options": ["aren't", "isn't", "don't", "doesn't"],
          "explanation": "**aren't** = are not. Be, not *don't*.",
          "explanation_cz": "**aren't** = are not. Be, ne *don't*."
        },
        {
          "en": "Where do you live?",
          "cz": "Kde bydlíš?",
          "gap": "Where ____ you live?",
          "gap_answer": "do",
          "accepts": [
            "Where do you live?"
          ],
          "quiz_options": ["do", "does", "are", "is"],
          "explanation": "**do** after Where. Not *Where you live?*",
          "explanation_cz": "**do** po Where. Ne *Where you live?*"
        },
        {
          "en": "Where does she work?",
          "cz": "Kde ona pracuje?",
          "gap": "Where ____ she work?",
          "gap_answer": "does",
          "accepts": [
            "Where does she work?"
          ],
          "quiz_options": ["does", "do", "is", "are"],
          "explanation": "**does** after Where + she. Verb = **work**.",
          "explanation_cz": "**does** po Where + she. Sloveso **work**."
        },
        {
          "en": "What does she like?",
          "cz": "Co má ráda?",
          "gap": "What ____ she like?",
          "gap_answer": "does",
          "accepts": [
            "What does she like?"
          ],
          "quiz_options": ["does", "do", "is", "are"],
          "explanation": "**does** after What + she. Not *What she like?*",
          "explanation_cz": "**does** po What + she. Ne *What she like?*"
        },
        {
          "en": "What do you like?",
          "cz": "Co máš rád?",
          "gap": "What ____ you like?",
          "gap_answer": "do",
          "accepts": [
            "What do you like?"
          ],
          "quiz_options": ["do", "does", "are", "is"],
          "explanation": "**do** after What + you.",
          "explanation_cz": "**do** po What + you."
        },
        {
          "en": "When do you study?",
          "cz": "Kdy se učíš?",
          "gap": "When ____ you study?",
          "gap_answer": "do",
          "accepts": [
            "When do you study?"
          ],
          "quiz_options": ["do", "does", "are", "is"],
          "explanation": "**do** after When. Not *When you study?*",
          "explanation_cz": "**do** po When. Ne *When you study?*"
        },
        {
          "en": "Do you like English?",
          "cz": "Máš rád angličtinu?",
          "gap": "____ you like English?",
          "gap_answer": "Do",
          "accepts": [
            "Do you like English?"
          ],
          "quiz_options": ["Do", "Does", "Are", "Is"],
          "explanation": "**Do** + you + like. Not *Are you like*.",
          "explanation_cz": "**Do** + you + like. Ne *Are you like*."
        },
        {
          "en": "Does Martin live in Brno?",
          "cz": "Bydlí Martin v Brně?",
          "gap": "____ Martin live in Brno?",
          "gap_answer": "Does",
          "accepts": [
            "Does Martin live in Brno?"
          ],
          "quiz_options": ["Does", "Do", "Is", "Are"],
          "explanation": "A name = he → **Does**. Verb = **live**.",
          "explanation_cz": "Jméno = he → **Does**. Sloveso **live**."
        },
        {
          "en": "I don't have a car.",
          "cz": "Nemám auto.",
          "gap": "I ____ have a car.",
          "gap_answer": "don't",
          "gap_accepts": [
            "do not"
          ],
          "accepts": [
            "I do not have a car.",
            "I don't have a car.",
            "I haven't got a car.",
            "I have not got a car."
          ],
          "quiz_options": ["don't", "doesn't", "isn't", "aren't"],
          "explanation": "**don't** + have. Not *am not have*.",
          "explanation_cz": "**don't** + have. Ne *am not have*."
        }
      ]
    }
