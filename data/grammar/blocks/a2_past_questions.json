  "intro": {
    "cards": [
      {
        "title": "Past questions & negatives",
        "title_cz": "Minulé otázky a zápor",
        "points": [
          "You know **I went** / **I saw** / **I worked**.",
          "In a question or with **not**, **did** takes the past. The verb goes back to the **base**.",
          "Czech has no extra word here: *Kam jsi šel?*"
        ],
        "table": {
          "headers": ["+", "Question / no"],
          "rows": [
            ["I **went**.", "Where **did** you **go**?"],
            ["She **saw** it.", "She **didn't see** it."]
          ]
        }
      },
      {
        "title": "Not the past form twice",
        "title_cz": "Minulost jen jednou",
        "text_first": true,
        "points": [
          "**did** is already past. Do not add *went / saw / had*.",
          "Same after **didn't**."
        ],
        "table": {
          "headers": ["Not", "Say"],
          "rows": [
            ["*Where did you went?*", "Where **did** you **go**?"],
            ["*I didn't saw it.*", "I **didn't see** it."],
            ["*Did she came?*", "**Did** she **come**?"]
          ]
        }
      },
      {
        "title": "Don't drop did",
        "title_cz": "did nesmí chybět",
        "text_first": true,
        "points": [
          "Not *Where you went yesterday?*",
          "English wants **did** in the question."
        ],
        "table": {
          "headers": ["Not", "Say"],
          "rows": [
            ["*Where you went?*", "Where **did** you **go**?"]
          ]
        }
      }
    ]
  }
