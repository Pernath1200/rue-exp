    {
      "id": "form",
      "title": "The right form · A2",
      "check": {
        "sequence": [
          "quiz"
        ]
      },
      "items": [
        {
          "en": "I need some advice.",
          "cz": "Potřebuju radu.",
          "gap": "I need ____. (advice)",
          "gap_answer": "some advice",
          "gap_accepts": [],
          "accepts": [
            "I need some advice."
          ],
          "quiz_options": [
            "some advice",
            "an advice",
            "some advices"
          ],
          "wrong": "I need an advice.",
          "explanation": "advice takes no a/an and no -s. Czech counts rada; English does not.",
          "explanation_cz": "advice = nepočitatelné: bez a/an, bez -s."
        },
        {
          "en": "She gave me good advice.",
          "cz": "Dala mi dobrou radu. (ona)",
          "gap": "She gave me ____. (advice)",
          "gap_answer": "good advice",
          "gap_accepts": [],
          "accepts": [
            "She gave me good advice."
          ],
          "quiz_options": [
            "good advice",
            "a good advice",
            "good advices"
          ],
          "wrong": "She gave me a good advice.",
          "explanation": "An adjective changes nothing: still no a/an, still no -s.",
          "explanation_cz": "Přídavné jméno nic nemění: pořád bez a/an."
        },
        {
          "en": "I have a lot of information.",
          "cz": "Mám hodně informací.",
          "gap": "I have ____. (information)",
          "gap_answer": "a lot of information",
          "gap_accepts": [],
          "accepts": [
            "I have a lot of information."
          ],
          "quiz_options": [
            "a lot of information",
            "a lot of informations",
            "many informations"
          ],
          "wrong": "I have a lot of informations.",
          "explanation": "information has no plural. Use a lot of, not many.",
          "explanation_cz": "information nemá množné číslo."
        },
        {
          "en": "This is useful information.",
          "cz": "Tohle jsou užitečné informace.",
          "gap": "This is ____. (information)",
          "gap_answer": "useful information",
          "gap_accepts": [],
          "accepts": [
            "This is useful information."
          ],
          "quiz_options": [
            "useful information",
            "an useful information",
            "useful informations"
          ],
          "wrong": "This is an useful information.",
          "explanation": "Czech informace is plural; English information never is.",
          "explanation_cz": "České informace je množné, anglické information nikdy."
        },
        {
          "en": "There isn't much furniture.",
          "cz": "Není moc nábytku.",
          "gap": "There isn't ____. (furniture)",
          "gap_answer": "much furniture",
          "gap_accepts": [],
          "accepts": [
            "There isn't much furniture."
          ],
          "quiz_options": [
            "much furniture",
            "many furnitures",
            "much furnitures"
          ],
          "wrong": "There aren't many furnitures.",
          "explanation": "furniture is uncountable, so much — and the verb stays singular.",
          "explanation_cz": "furniture = nepočitatelné, proto much a sloveso v jednotném čísle."
        },
        {
          "en": "Is there any news?",
          "cz": "Jsou nějaké novinky?",
          "gap": "Is there ____? (news)",
          "gap_answer": "any news",
          "gap_accepts": [],
          "accepts": [
            "Is there any news?"
          ],
          "quiz_options": [
            "any news",
            "any newses",
            "many news"
          ],
          "wrong": "Are there any newses?",
          "explanation": "news ends in -s but is singular: is there, not are there.",
          "explanation_cz": "news končí na -s, ale je jednotné: is there."
        },
        {
          "en": "I don't have any money.",
          "cz": "Nemám peníze.",
          "gap": "I don't have ____. (money)",
          "gap_answer": "any money",
          "gap_accepts": [],
          "accepts": [
            "I don't have any money."
          ],
          "quiz_options": [
            "any money",
            "any moneys",
            "much moneys"
          ],
          "wrong": "I don't have any moneys.",
          "explanation": "Czech peníze is plural; English money has no plural.",
          "explanation_cz": "České peníze je množné, anglické money ne."
        },
        {
          "en": "We bought some bread.",
          "cz": "Koupili jsme chleba.",
          "gap": "We bought ____. (bread)",
          "gap_answer": "some bread",
          "gap_accepts": [],
          "accepts": [
            "We bought some bread."
          ],
          "quiz_options": [
            "some bread",
            "two breads",
            "a bread"
          ],
          "wrong": "We bought two breads.",
          "explanation": "bread is uncountable. To count it you need a measure word.",
          "explanation_cz": "bread = nepočitatelné. Počítá se přes měrové slovo."
        },
        {
          "en": "There isn't much traffic today.",
          "cz": "Dnes není moc dopravy.",
          "gap": "There isn't ____ today. (traffic)",
          "gap_answer": "much traffic",
          "gap_accepts": [],
          "accepts": [
            "There isn't much traffic today."
          ],
          "quiz_options": [
            "much traffic",
            "many traffics",
            "a traffic"
          ],
          "wrong": "There aren't many traffics today.",
          "explanation": "traffic is uncountable — much, and no plural.",
          "explanation_cz": "traffic = nepočitatelné: much, bez množného čísla."
        },
        {
          "en": "We need more space.",
          "cz": "Potřebujeme víc místa.",
          "gap": "We need ____. (space)",
          "gap_answer": "more space",
          "gap_accepts": [],
          "accepts": [
            "We need more space."
          ],
          "quiz_options": [
            "more space",
            "more spaces",
            "many spaces"
          ],
          "wrong": "We need more spaces.",
          "explanation": "space meaning room is uncountable.",
          "explanation_cz": "space ve významu místo je nepočitatelné."
        },
        {
          "en": "Can I have some sugar?",
          "cz": "Můžu dostat cukr?",
          "gap": "Can I have ____? (sugar)",
          "gap_answer": "some sugar",
          "gap_accepts": [],
          "accepts": [
            "Can I have some sugar?"
          ],
          "quiz_options": [
            "some sugar",
            "a sugar",
            "some sugars"
          ],
          "wrong": "Can I have a sugar?",
          "explanation": "sugar is uncountable: some, never a.",
          "explanation_cz": "sugar = nepočitatelné: some, nikdy a."
        },
        {
          "en": "He wants a sandwich.",
          "cz": "Chce sendvič.",
          "gap": "He wants ____. (sandwich)",
          "gap_answer": "a sandwich",
          "gap_accepts": [],
          "accepts": [
            "He wants a sandwich."
          ],
          "quiz_options": [
            "a sandwich",
            "some sandwich",
            "sandwich"
          ],
          "wrong": "He wants sandwich.",
          "explanation": "A countable noun in the singular must have a/an — never bare.",
          "explanation_cz": "Počitatelné v jednotném čísle musí mít a/an."
        },
        {
          "en": "She bought three chairs.",
          "cz": "Koupila tři židle.",
          "gap": "She bought ____. (chair)",
          "gap_answer": "three chairs",
          "gap_accepts": [],
          "accepts": [
            "She bought three chairs."
          ],
          "quiz_options": [
            "three chairs",
            "three chair",
            "three furnitures"
          ],
          "wrong": "She bought three chair.",
          "explanation": "chair is countable, so it takes a number and -s. furniture never does.",
          "explanation_cz": "chair je počitatelné: číslo a -s. furniture nikdy."
        },
        {
          "en": "There are some eggs.",
          "cz": "Jsou nějaká vejce.",
          "gap": "There are ____. (egg)",
          "gap_answer": "some eggs",
          "gap_accepts": [],
          "accepts": [
            "There are some eggs."
          ],
          "quiz_options": [
            "some eggs",
            "some egg",
            "a eggs"
          ],
          "wrong": "There are some egg.",
          "explanation": "Countable + some means plural: eggs.",
          "explanation_cz": "Počitatelné + some = množné číslo."
        },
        {
          "en": "They have three rooms.",
          "cz": "Mají tři pokoje.",
          "gap": "They have ____. (room)",
          "gap_answer": "three rooms",
          "gap_accepts": [],
          "accepts": [
            "They have three rooms."
          ],
          "quiz_options": [
            "three rooms",
            "three room",
            "much rooms"
          ],
          "wrong": "They have three room.",
          "explanation": "room meaning a part of a house is countable — unlike room = space.",
          "explanation_cz": "room jako místnost je počitatelné."
        },
        {
          "en": "I don't have any coins.",
          "cz": "Nemám žádné mince.",
          "gap": "I don't have ____. (coin)",
          "gap_answer": "any coins",
          "gap_accepts": [],
          "accepts": [
            "I don't have any coins."
          ],
          "quiz_options": [
            "any coins",
            "any coin",
            "much coins"
          ],
          "wrong": "I don't have any coin.",
          "explanation": "coin is countable, so any takes the plural.",
          "explanation_cz": "coin je počitatelné, takže any + množné číslo."
        }
      ]
    }
  ],
