  "intro": {
    "cards": [
      {
        "title": "Why this topic?",
        "body": "Later units talk about **nouns**, **verbs**, and other word classes. This short stop gives you those **names** so the rest of the app is easier to follow.",
        "points": [
          "You will see these words again in form tips and explanations",
          "You do not need a full grammar book — just these four labels for now",
          "Next topics (be/have, word order, present simple) use the same names"
        ],
        "title_cz": "Proč tohle téma"
      },
      {
        "title": "What it is",
        "body": "Every word belongs to a **class**. At A1 we start with four useful classes.",
        "table": {
          "headers": [
            "Class · Třída",
            "Job",
            "Examples"
          ],
          "rows": [
            [
              "noun · *podstatné jméno*",
              "person / place / thing",
              "dog · teacher · Brno"
            ],
            [
              "verb · *sloveso*",
              "action or being",
              "work · like · is"
            ],
            [
              "adjective · *přídavné jméno*",
              "describes a noun",
              "small · new · hot"
            ],
            [
              "pronoun · *zájmeno*",
              "stands for a person",
              "I · you · she · they"
            ]
          ]
        },
        "title_cz": "Slovní druhy",
        "body_cz": "podstatné jméno = noun · sloveso = verb · přídavné jméno = adjective · zájmeno = pronoun"
      },
      {
        "title": "How to test a word",
        "points": [
          "Person, place, or thing? → **noun** · *podstatné jméno*",
          "Action or being? → **verb** · *sloveso*",
          "Describes a noun? → **adjective** · *přídavné jméno*",
          "Stands for *I / you / he…*? → **pronoun** · *zájmeno*"
        ],
        "table": {
          "headers": [
            "Phrase",
            "Classes"
          ],
          "rows": [
            [
              "a **small** **dog**",
              "adjective + noun"
            ],
            [
              "**She** **works**",
              "pronoun + verb"
            ],
            [
              "**I** **like** coffee",
              "pronoun + verb + noun"
            ]
          ]
        },
        "title_cz": "Jak slovo poznat"
      },
      {
        "title": "Common mistakes",
        "table": {
          "headers": [
            "Avoid",
            "Say / think"
          ],
          "rows": [
            [
              "Treating *is* as a noun",
              "*is* is a **verb** (be)"
            ],
            [
              "Calling *happy* a verb",
              "*happy* is an **adjective**"
            ],
            [
              "Forgetting *I / she* are pronouns",
              "they stand for a person"
            ],
            [
              "One word = one class always",
              "some words can change class later"
            ]
          ]
        },
        "points": [
          "CZ tip: *je* → English often needs **is** (verb), not a Czech-style gap"
        ],
        "title_cz": "Časté chyby"
      },
      {
        "title": "Quick check",
        "points": [
          "dog → **noun**",
          "work → **verb**",
          "new → **adjective**",
          "they → **pronoun**",
          "She likes books. → pronoun · verb · noun"
        ],
        "title_cz": "Rychlá kontrola"
      }
    ]
  }
