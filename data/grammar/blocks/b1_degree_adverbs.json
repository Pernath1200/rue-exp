      "id": "b1_degree_main",
      "title": "Degree adverbs · B1",
      "items": [
        {
          "en": "It's a bit cold.",
          "cz": "Je trochu zima.",
          "gap": "It's ____ cold. (low)",
          "gap_answer": "a bit",
          "accepts": [
            "It's a bit cold.",
            "It is a bit cold.",
            "It's a little cold.",
            "It is a little cold."
          ],
          "gap_accepts": [
            "a bit",
            "a little"
          ],
          "quiz_options": [
            "a bit",
            "quite",
            "very",
            "extremely"
          ],
          "explanation": "a bit = low on the scale.",
          "explanation_cz": "a bit = nízko na stupnici."
        },
        {
          "en": "We were quite tired after the walk.",
          "cz": "Byli jsme po té procházce docela unavení.",
          "gap": "We were ____ tired after the walk. (middle)",
          "gap_answer": "quite",
          "accepts": [
            "We were quite tired after the walk."
          ],
          "quiz_options": [
            "quite",
            "a bit",
            "very",
            "extremely"
          ],
          "explanation": "quite = middle of the scale.",
          "explanation_cz": "quite = uprostřed stupnice."
        },
        {
          "en": "The exam was very hard.",
          "cz": "Ta zkouška byla velmi těžká.",
          "gap": "The exam was ____ hard. (high)",
          "gap_answer": "very",
          "accepts": [
            "The exam was very hard.",
            "The exam was really hard."
          ],
          "gap_accepts": [
            "very",
            "really"
          ],
          "quiz_options": [
            "very",
            "a bit",
            "quite",
            "enough"
          ],
          "explanation": "very = high on the scale. really sits here too.",
          "explanation_cz": "very = vysoko na stupnici. really sem patří taky."
        },
        {
          "en": "The water is warm enough to swim in.",
          "cz": "Voda je dost teplá na koupání.",
          "gap": "The water is warm ____ to swim in.",
          "gap_answer": "enough",
          "accepts": [
            "The water is warm enough to swim in.",
            "The water is warm enough to swim."
          ],
          "wrong": "The water is enough warm to swim in.",
          "quiz_options": [
            "enough",
            "too",
            "very",
            "quite"
          ],
          "explanation": "enough after the adjective, then to: warm enough to swim in.",
          "explanation_cz": "enough za přídavným jménem, pak to: warm enough to swim in."
        },
        {
          "en": "The weather was extremely difficult for driving.",
          "cz": "Počasí bylo na řízení extrémně náročné.",
          "gap": "The weather was ____ difficult for driving. (top)",
          "gap_answer": "extremely",
          "accepts": [
            "The weather was extremely difficult for driving."
          ],
          "quiz_options": [
            "extremely",
            "a bit",
            "quite",
            "very"
          ],
          "explanation": "extremely = the top of the 0–100 scale.",
          "explanation_cz": "extremely = vrchol stupnice 0–100."
        },
        {
          "en": "The trip was not very relaxing.",
          "cz": "Výlet nebyl moc odpočinkový.",
          "gap": "The trip was not ____ relaxing.",
          "gap_answer": "very",
          "accepts": [
            "The trip was not very relaxing.",
            "The trip was not really relaxing."
          ],
          "gap_accepts": [
            "very",
            "really"
          ],
          "wrong": "The trip was not so much relaxing.",
          "quiz_options": [
            "very",
            "so much",
            "much",
            "too much"
          ],
          "explanation": "Czech *ne moc* = not very. Never *not so much relaxing*.",
          "explanation_cz": "České *ne moc* = not very. Nikdy *not so much relaxing*."
        },
        {
          "en": "The sea was too cold to swim in.",
          "cz": "Moře bylo příliš studené na koupání.",
          "gap": "The sea was ____ cold to swim in.",
          "gap_answer": "too",
          "accepts": [
            "The sea was too cold to swim in."
          ],
          "wrong": "The sea was very cold to swim in.",
          "quiz_options": [
            "too",
            "very",
            "quite",
            "a bit"
          ],
          "explanation": "too = past the need. *very cold* only describes.",
          "explanation_cz": "too = za potřebou. *very cold* jen popisuje."
        },
        {
          "en": "He drove too fast to stop.",
          "cz": "Jel příliš rychle na to, aby zastavil.",
          "gap": "He drove ____ fast to stop.",
          "gap_answer": "too",
          "accepts": [
            "He drove too fast to stop."
          ],
          "wrong": "He drove very fast to stop.",
          "quiz_options": [
            "too",
            "very",
            "quite",
            "a bit"
          ],
          "explanation": "too + adverb + to: too fast to stop.",
          "explanation_cz": "too + příslovce + to: too fast to stop."
        },
        {
          "en": "Our room was not big enough for four people.",
          "cz": "Náš pokoj nebyl dost velký pro čtyři lidi.",
          "gap": "Our room was not big ____ for four people.",
          "gap_answer": "enough",
          "accepts": [
            "Our room was not big enough for four people.",
            "Our room was not big enough for 4 people."
          ],
          "wrong": "Our room was not enough big for four people.",
          "quiz_options": [
            "enough",
            "too",
            "very",
            "quite"
          ],
          "explanation": "enough comes AFTER the adjective: big enough.",
          "explanation_cz": "enough stojí AŽ ZA přídavným jménem: big enough."
        },
        {
          "en": "She's old enough to drive.",
          "cz": "Je dost stará na to, aby řídila.",
          "gap": "She's old ____ to drive.",
          "gap_answer": "enough",
          "accepts": [
            "She's old enough to drive.",
            "She is old enough to drive."
          ],
          "wrong": "She's enough old to drive.",
          "quiz_options": [
            "enough",
            "too",
            "very",
            "quite"
          ],
          "explanation": "enough after the adjective, then to: old enough to drive.",
          "explanation_cz": "enough za přídavným jménem, pak to: old enough to drive."
        },
        {
          "en": "The tickets were far too expensive.",
          "cz": "Lístky byly až příliš drahé.",
          "gap": "The tickets were ____ too expensive.",
          "gap_answer": "far",
          "accepts": [
            "The tickets were far too expensive.",
            "The tickets were way too expensive.",
            "The tickets were too expensive."
          ],
          "gap_accepts": [
            "far",
            "way"
          ],
          "wrong": "The tickets were very too expensive.",
          "quiz_options": [
            "far",
            "very",
            "really",
            "quite"
          ],
          "explanation": "To strengthen too, use far/way. *very too* is impossible.",
          "explanation_cz": "Pro zesílení too: far/way. *very too* nejde."
        },
        {
          "en": "We arrived a bit late.",
          "cz": "Přijeli jsme trochu pozdě.",
          "gap": "We arrived ____ late. (low)",
          "gap_answer": "a bit",
          "accepts": [
            "We arrived a bit late.",
            "We arrived a little late."
          ],
          "gap_accepts": [
            "a bit",
            "a little"
          ],
          "quiz_options": [
            "a bit",
            "quite",
            "very",
            "extremely"
          ],
          "explanation": "a bit = low on the scale, with adverbs too.",
          "explanation_cz": "a bit = nízko na stupnici, i u příslovcí."
        }
      ]
    }
  ]
