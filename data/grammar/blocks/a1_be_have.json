  "intro": {
    "cards": [
      {
        "title": "What it is",
        "body": "Two very common verbs — **be** and **have**. They do different jobs.",
        "table": {
          "headers": [
            "Verb",
            "CZ",
            "Example"
          ],
          "rows": [
            [
              "be (am / is / are)",
              "být",
              "I **am** a student."
            ],
            [
              "have (have / has)",
              "mít",
              "I **have** a car."
            ]
          ]
        }
      },
      {
        "title": "Form · be",
        "table": {
          "headers": [
            "",
            "positive",
            "negative",
            "short negative"
          ],
          "rows": [
            [
              "I",
              "am",
              "am not",
              "I'm not"
            ],
            [
              "you / we / they",
              "are",
              "are not",
              "aren't"
            ],
            [
              "he / she / it",
              "is",
              "is not",
              "isn't"
            ]
          ]
        },
        "points": [
          "Questions: **Are** you…? **Is** she…?",
          "Short forms are common in speech: **isn't** = is not",
          "Don't say *I be* or *he are*"
        ]
      },
      {
        "title": "Form · have",
        "table": {
          "headers": [
            "",
            "positive",
            "negative",
            "short negative"
          ],
          "rows": [
            [
              "I / you / we / they",
              "have",
              "do not have",
              "don't have"
            ],
            [
              "he / she / it",
              "has",
              "does not have",
              "doesn't have"
            ]
          ]
        },
        "points": [
          "*have got* = *have* in meaning: I've got a bike ≈ I have a bike",
          "he/she → **has** (not *haves*)",
          "Short: **don't** / **doesn't** + have"
        ]
      },
      {
        "title": "Common mistakes",
        "table": {
          "headers": [
            "Avoid",
            "Say"
          ],
          "rows": [
            [
              "I **have** 25 years.",
              "I **am** 25. / I **am** 25 years old."
            ],
            [
              "She **have** a dog.",
              "She **has** a dog."
            ],
            [
              "They **is** students.",
              "They **are** students."
            ],
            [
              "I **am** a car.",
              "I **have** a car."
            ]
          ]
        },
        "points": [
          "Age → **be**, not have (CZ *mám … let*)",
          "Possession → **have**, not be"
        ]
      },
      {
        "title": "Quick check",
        "points": [
          "I ____ a student. → **am**",
          "She ____ a teacher. → **is**",
          "They ____ a flat. → **have**",
          "He ____ a bike. → **has**"
        ]
      }
    ]
  },
