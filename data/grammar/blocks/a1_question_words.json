            ],
            [
              "What is your name?",
              "info"
            ],
            [
              "What do you want?",
              "thing + do"
            ],
            [
              "What does he do?",
              "job (common A1)"
            ]
          ]
        },
        "examples": [
          {
            "en": "What is your name?",
            "cz": "Jak se jmenuješ? / Jaké je tvé jméno?"
          },
          {
            "en": "What do you want?",
            "cz": "Co chceš?"
          }
        ],
        "points": [
          "what = thing, idea, or job",
          "What does he do? often = what is his job?"
        ],
        "body_cz": "what = co. What does he do? = Co dělá? (často práce)."
      },
      {
