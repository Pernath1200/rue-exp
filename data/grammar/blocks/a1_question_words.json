  "intro": {
    "cards": [
      {
        "title": "Question words",
        "title_cz": "Tázací slova — kdo / co / kde…",
        "body": "These words open a question. Match each word to what it asks about.",
        "body_cz": "Otevírají otázku. Nejdřív spáruj slovo s významem (when = time…).",
        "table": {
          "caption": "six words · A1",
          "headers": [
            "EN",
            "Asks about",
            "CZ"
          ],
          "rows": [
            [
              "who",
              "person",
              "kdo"
            ],
            [
              "what",
              "thing / job",
              "co"
            ],
            [
              "where",
              "place",
              "kde"
            ],
            [
              "when",
              "time",
              "kdy"
            ],
            [
              "why",
              "reason",
              "proč"
            ],
            [
              "how",
              "way / manner",
              "jak"
            ]
          ]
        },
        "points": [
          "First practice: Match word ↔ meaning",
          "Then: full questions with do/does/be"
        ]
      },
      {
        "title": "who",
        "title_cz": "who = kdo — person",
        "table": {
          "caption": "who",
          "headers": [
            "English",
            "Job"
          ],
          "rows": [
            [
              "Who is she?",
              "person (be)"
            ],
            [
              "Who is that?",
              "person"
            ],
            [
              "Who do you live with?",
              "person + do"
            ]
          ]
        },
        "examples": [
          {
            "en": "Who is your teacher?",
            "cz": "Kdo je tvůj učitel?"
          },
          {
            "en": "Who do you live with?",
            "cz": "S kým bydlíš?"
          }
        ],
        "points": [
          "who = a person (not a thing)",
          "With be: Who is…? · With other verbs: Who do/does…?"
        ]
      },
      {
        "title": "what",
        "title_cz": "what = co — thing / job",
        "table": {
