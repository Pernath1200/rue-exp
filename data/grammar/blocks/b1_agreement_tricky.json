    "points": [
     "You already know that **he /** she / it takes the -s form.",
     "These three groups are the ones where the verb does not follow the meaning."
    ],
    "table": {
     "headers": [
      "Subject",
      "Verb"
     ],
     "rows": [
      [
       "everybody · everyone · nobody",
       "**is /** has / knows *(singular)*"
      ],
