  "intro": [
    {
      "title": "Saying hello, thanks and sorry",
      "title_cz": "Pozdravy, poděkování a omluva",
      "table": {
        "headers": ["Polite", "Short"],
        "rows": [
          ["Hello", "Hi"],
          ["Goodbye", "Bye"],
          ["Thank you", "Thanks"]
        ]
      },
      "note": "Use the longer form with people you do not know.",
      "note_cz": "Delší tvar je zdvořilejší — používejte ho s cizími lidmi."
    },
    {
      "title": "You will use these",
      "frames": [
        "Hello. / Hi. · *Dobrý den / Ahoj*",
        "Goodbye. / Bye. · *Nashledanou / Ahoj*",
        "Thank you. / Thanks. · *Děkuji / Díky*",
        "Yes, please. · *Ano, prosím*",
        "Sorry. · *Promiň / Promiňte*",
        "Excuse me. · *Promiňte*",
        "Nice to meet you. · *Těší mě*"
      ],
      "note": "Say **Sorry** when you have done something wrong. Say **Excuse me** *before* you speak to someone you do not know.",
      "note_cz": "Sorry = omlouvám se. Excuse me = když chcete někoho oslovit."
    }
  ],
