  "intro": [
    {
      "title": "Object pronouns, possessives, this and that",
      "title_cz": "Předmětová zájmena, přivlastňovací zájmena, this a that",
      "body": "Object pronouns come after the verb: me, him, her, us, them.\nPossessives come in front of a noun: my, your, our, their.\nThis and that point at something. This is near you. That is further away."
    },
    {
      "title": "You will use these words in",
      "title_cz": "Tato slova použijete ve větách",
      "frames": [
        "She helps me.",
        "I see him.",
        "This is my bag.",
        "That is your car.",
        "The book is under the table."
      ],
      "note": "English changes the pronoun when it is the object: he → him, she → her, they → them. I see him, never I see he.",
      "note_cz": "Pozor: předmětový tvar je jiný — he → him, she → her, they → them."
    }
  ],
