  "intro": [
    {
      "title": "How often, not what",
      "title_cz": "Jak často, ne co",
      "diagram": "cycle",
      "labels": [
        "daily",
        "regular",
        "usual",
        "habit"
      ],
      "body": "These words do not name a thing you can point at. They say how often something happens, and how ordinary it is.\nA habit is the whole loop: the same thing, at the usual time, every day.",
      "body_cz": "Slova o tom, jak často se něco děje — ne o věcech."
    },
    {
      "title": "You will use these words in",
      "frames": [
        "This is a …",
        "I have a …",
        "I need a …",
        "It is …"
      ],
      "note": "Czech už is two English words. already goes in a statement: I am already at work. yet goes in a question or a negative: Are you ready? — Not yet.",
      "note_cz": "Pozor: už = already (v kladné větě) i yet (v otázce a v záporu)."
    }
  ]
